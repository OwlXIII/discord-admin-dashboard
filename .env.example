# Copy this file to ".env" and fill in your real values.
# The .env file is gitignored, so your secrets stay out of version control.
# Get these from the Discord Developer Portal: https://discord.com/developers/applications

# OAuth2 credentials (OAuth2 tab)
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret

# Bot token (Bot tab -> Reset Token). Also enable the "Server Members Intent".
DISCORD_BOT_TOKEN=your-bot-token

# Must exactly match a redirect added under OAuth2 -> Redirects
DISCORD_REDIRECT_URI=http://localhost:8080/oauth/redirect

# Optional overrides
# APP_DASHBOARD_URL=http://localhost:8080/dashboard.html
# APP_COOKIE_SECURE=false
# APP_JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes-long
# APP_JWT_TTL_MINUTES=60
# SERVER_PORT=8080
